#cloud-config
# RKE2 (CIS-профиль, Canal → NetworkPolicy, встроенный etcd на 3 server-узлах). Секреты (token) — из Terraform var,
# которая приходит из Vault; kubeconfig забирает Ansible/CI.
package_update: true
packages: [chrony, apparmor]
write_files:
  - path: /etc/rancher/rke2/config.yaml
    permissions: "0600"
    content: |
      token: ${token}
      server: ${server_url}
      cni: ${cni}
      profile: ${cis_profile}
      node-label:
%{ for k, v in node_labels ~}
        - "${k}=${v}"
%{ endfor ~}
      kube-apiserver-arg:
        - "audit-log-path=/var/lib/rancher/rke2/server/logs/audit.log"
        - "audit-log-maxage=30"
      etcd-snapshot-schedule-cron: "0 */6 * * *"
      etcd-snapshot-retention: 28
      etcd-s3: true
      etcd-s3-endpoint: minio.infra.parking.uz:9000
      etcd-s3-bucket: etcd-snapshots
  - path: /etc/sysctl.d/60-rke2-cis.conf
    content: |
      vm.panic_on_oom=0
      vm.overcommit_memory=1
      kernel.panic=10
      kernel.panic_on_oops=1
runcmd:
  - useradd -r -c "etcd user" -s /sbin/nologin -M etcd -U || true
  - curl -sfL https://get.rke2.io | INSTALL_RKE2_VERSION="v1.33.5+rke2r1" INSTALL_RKE2_TYPE=server sh -
  - systemctl enable --now rke2-server
