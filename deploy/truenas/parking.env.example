# Настройки сервера парковки. install.sh при первом запуске копирует этот файл в parking.env.
# Компания, площадка, подсеть и логин администратора применяются ОДИН раз — при первой установке (пустая база).
# Потом они меняются в панели: «Площадки», «Сотрудники».

# Название компании и площадки
PARKING_COMPANY=MediaPark
PARKING_LOT_NAME=MediaPark
PARKING_LOT_CAPACITY=54
PARKING_TIMEZONE=Asia/Tashkent

# Подсеть, где стоят камеры и стрелы: сервер командует устройствам только из этих подсетей (защита от SSRF).
# Несколько — через запятую: 192.168.13.0/24,192.168.1.0/24
PARKING_LOT_CIDRS=192.168.13.0/24

# Логин первого администратора (пароль — случайный, в LOGINS.txt; при первом входе система попросит сменить)
PARKING_ADMIN_LOGIN=admin@mediapark.uz

# Порт панели: http://<IP сервера>:8080 (80 и 443 заняты веб-интерфейсом TrueNAS)
PARKING_HTTP_PORT=8080

# Куда backup.sh складывает резервные копии (папка на пуле TrueNAS, например /mnt/tank/anpr/backup)
PARKING_BACKUP_DIR=/mnt/tank/anpr/backup
PARKING_BACKUP_KEEP_DAYS=14

# Круглосуточная запись камер (sudo bash deploy/truenas/video.sh): папка на пуле для видео, в ней — cam-entry
# (въезд), cam-exit (выезд). Лучше отдельный диск: пул records и раздел на каждую камеру с квотой (README, §10).
PARKING_VIDEO_DIR=/mnt/records
# Сколько дней хранить; раньше удаляются самые старые часы, если раздел заполнен больше чем на PERCENT %
PARKING_VIDEO_KEEP_DAYS=30
PARKING_VIDEO_MAX_USE_PERCENT=90
# Поток камеры: 101 — основной (2688×1520; при 4 Мбит/с ≈ 41 ГБ в сутки), 102 — дополнительный (1080p, вдвое меньше)
PARKING_VIDEO_STREAM=101
