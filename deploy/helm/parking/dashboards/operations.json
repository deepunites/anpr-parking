            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (result) (rate(entry_total{lot=~\"$lot\"}[5m])) * 60",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
