      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(barrier_command_total{lot=~\"$lot\",command=\"OPEN\",result=\"OK\"}[10m])) / sum(rate(barrier_command_total{lot=~\"$lot\",command=\"OPEN\"}[10m]))",
