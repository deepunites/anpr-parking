        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(barrier_command_total{command=\"OPEN\",result=\"OK\"}[10m])) / sum(rate(barrier_command_total{command=\"OPEN\"}[10m]))",
          "legendFormat": "success",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 8
