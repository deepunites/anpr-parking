      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(rate(http_request_duration_seconds_count{status_class=\"5xx\"}[30d])) / sum(rate(http_request_duration_seconds_count[30d]))) / 0.001",
          "legendFormat": "budget used",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
